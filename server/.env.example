NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://beverage:beverage_dev@localhost:5432/beverage_dev?schema=public
# Non-pooled connection for migrations (Supabase: the direct :5432 URL, not
# the PgBouncer :6543 pooled one). Locally it's the same as DATABASE_URL.
DIRECT_URL=postgresql://beverage:beverage_dev@localhost:5432/beverage_dev?schema=public
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars_long
JWT_ACCESS_TTL_SECONDS=86400
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_COST=12
LOG_LEVEL=info
# Comma-separated browser origin allowlist for CORS. Unset in dev (Vite proxy
# is same-origin); set to the admin-web origin(s) in production.
# CORS_ORIGIN=https://admin.example.com
# Canonical business-day timezone (order/delivery/shift dates, daily reports,
# POS day, alerts) and the timezone the nightly/hourly crons fire in. Operator
# is single-city Pakistan, so both default to Asia/Karachi.
BUSINESS_TIMEZONE=Asia/Karachi
CRON_TIMEZONE=Asia/Karachi
# Cloudflare R2 (private bucket) for delivery-proof photos. Set all four to
# enable uploads; leave unset to keep photos local (upload is a no-op seam).
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET=delivery-proofs
# Production seed bootstrap credential (required when NODE_ENV=production; the
# seed refuses to plant a default Super Admin PIN). 6 digits, rotate after first
# login. Leave unset in dev — the seed uses a known dev credential there.
# SEED_SUPERADMIN_PHONE=03001234567
# SEED_SUPERADMIN_PIN=000000
